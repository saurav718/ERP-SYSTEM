{
  "name": "industrialflow-erp",
  "version": "1.0.0",
  "private": true,
  "description": "IndustrialFlow is a deliberately focused PERN ERP for a manufacturing and supply business. It demonstrates a traceable order lifecycle rather than broad, shallow CRUD:",
  "homepage": "https://github.com/rajesh-kumar-pradhan/ERP-SYSTEM#readme",
  "bugs": {
    "url": "https://github.com/rajesh-kumar-pradhan/ERP-SYSTEM/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rajesh-kumar-pradhan/ERP-SYSTEM.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=backend & npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "test": "npm run test --workspace=backend",
    "prisma:generate": "npm run prisma:generate --workspace=backend",
    "prisma:migrate": "npm run prisma:migrate --workspace=backend",
    "prisma:seed": "npm run prisma:seed --workspace=backend"
  }
}
